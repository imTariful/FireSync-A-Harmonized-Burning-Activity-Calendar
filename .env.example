# FireSync environment template. Copy to .env and fill placeholders locally.
# NEVER commit a real .env or a real FIRMS MAP_KEY.

# Server port
PORT=3000

# NASA FIRMS MAP_KEY (server-side only; never exposed to browser JavaScript)
# Request a free key: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY="YOUR_NASA_FIRMS_MAP_KEY"

# Optional alternate FIRMS base URL for offline integration tests only.
# Leave empty for the official NASA service in production.
FIRMS_BASE_URL=""

# Optional durable storage adapter. A plain JSON file (not PostgreSQL/PostGIS).
# Leave empty to use in-memory storage: empty at startup, not durable, lost on restart.
FIRESYNC_STORE_PATH=""

# In-app alerts persist only when this optional path is configured.
FIRESYNC_WATCHLIST_PATH=""
FIRESYNC_WATCHLIST_INTERVAL_MINUTES=30

# Optional frozen local products (never download/regenerate automatically).
# Run from the folder containing package.json. Relative paths use that folder.
# Use forward slashes in .env paths; absolute paths may point to external datasets.
# FIRESYNC_HISTORICAL_PARQUET="data/historical/parquet"
# FIRESYNC_AGNICALENDAR_PARQUET="Harmonized Data Set/AgniCalendar_Global_Harmonized_CellMonth/year=*/part-*.parquet"
# FIRESYNC_AGNI_CELL_COUNTRY="data/agnicalendar/cell_country.parquet"
# Optional country-builder input; otherwise derived from FIRESYNC_HISTORICAL_PARQUET.
# FIRESYNC_HISTORICAL_OBS="data/historical/parquet/obs/sensor=*/year=*/data_*.parquet"

# Optional PostgreSQL/PostGIS connection for future work. The application does NOT
# read or write through this yet; leaving it empty is the honest default.
DATABASE_URL=""

# Only used by the optional PostGIS container profile (docker compose --profile postgis).
# Set a strong value in your shell or local .env; there is no default password.
POSTGRES_USER="firesync"
POSTGRES_PASSWORD=""

# CORS is not enabled in this build; this value is reserved for a future explicit allow-list.
CORS_ORIGINS=""

# --------------------------------------------------------------------------- AI (Groq)
# Server-only. The key is never sent to the browser; leave it empty to keep every AI route off.
# Create one at https://console.groq.com/keys (free tier, OpenAI-compatible API).
GROQ_API_KEY=""
# Model id; the default is openai/gpt-oss-120b (supports tool calling).
GROQ_MODEL="openai/gpt-oss-120b"
# Optional override; defaults to https://api.groq.com/openai/v1
# GROQ_API_BASE="https://api.groq.com/openai/v1"
FIRESYNC_AI_ENABLED=false
